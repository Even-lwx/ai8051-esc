   70   2              && (PWMIN_PERIOD_MAX_TICK >= pwmin.period))
   71   2              {
   72   3                  pwmin_period_valid = 1;
   73   3              }
   74   2          }
   75   1      
   76   1          if(sr1 & PWMB_SR1_CC6IF)
   77   1          {
   78   2              // 必须先读取高字节，再单独读取低字节；读取低字节会清除 CC6 标志。
   79   2              capture_high = PWMB_CCR6H;
   80   2              pwmin.high_value = ((uint16)capture_high << 8);
   81   2              pwmin.high_value |= PWMB_CCR6L;
   82   2              pwmin.high_time = pwmin.high_value;
   83   2      
   84   2              if((0 == frame_overcapture)
   85   2              && pwmin_period_valid
   86   2              && (PWMIN_HIGH_MIN_TICK <= pwmin.high_time)
   87   2              && (PWMIN_HIGH_MAX_TICK >= pwmin.high_time))
   88   2              {
   89   3                  temp = pwmin.high_time - PWMIN_HIGH_MIN_TICK;
   90   3                  if(temp < 50u)
   91   3                  {
   92   4                      temp = 0;
   93   4                  }
   94   3                  pwmin.throttle = temp;
   95   3                  pwm_input_timeout_count = 0;
   96   3      
   97   3      #if (BLDC_USR_DUTY == 0)
   98   3                  motor.duty = (uint32)pwmin.throttle * BLDC_PWM_ARR_MAX / 1000u;
   99   3      #endif
  100   3              }
  101   2      
  102   2              // 一个周期只消费一次周期捕获，下一帧必须重新取得有效 CC5。
  103   2              pwmin_period_valid = 0;
  104   2          }
  105   1      
  106   1      #if (BLDC_USR_DUTY > 0)
