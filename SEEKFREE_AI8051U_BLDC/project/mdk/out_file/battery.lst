   27          #define ADC_CH    1           /* 1~16, ADC转换通道数, 需同步修改 DMA_ADC_CHSW 转换通道 */
   28          #define ADC_DATA  6           /* 6~n, 每个通道ADC转换数据总数, 2*转换次数+4, 需同步修改 DMA_ADC_CFG2 转换次数 *
             -/
   29          #define DMA_ADDR  0x800         /* DMA数据存放地址 */
   30          static uint8 xdata adc_dma_buff[ADC_CH][ADC_DATA] _at_ DMA_ADDR;
   31          
   32          uint16 battery_voltage;
   33          
   34          //-------------------------------------------------------------------------------------------------------
             -------------
   35          //  @brief      电池电压获取
   36          //  @param      void                        
   37          //  @return     uint8   0-正常 1-电池电压过低          
   38          //  @since      v1.0
   39          //  Sample usage:
   40          //-------------------------------------------------------------------------------------------------------
             -------------
   41          uint8 battery_voltage_get(void)
   42          {
   43   1          uint16 pin_voltage;
   44   1          static uint32 low_power_num = 0;
   45   1          uint16 adc_reg_value;
   46   1        
   47   1          adc_reg_value = adc_dma_buff[0][0];
   48   1          pin_voltage = (uint32)adc_reg_value * 5000 / 256;       // 将ADC值转换为实际的电压
   49   1          battery_voltage = (uint32)pin_voltage * 57 / 10;      // 根据硬件分压电阻的值计算电池电压
   50   1        
   51   1        // 开启下一次ADC_DMA转换
   52   1        DMA_ADC_CR = 0xc0;
C251 COMPILER V5.60.0,  battery                                                            08/08/26  11:10:19  PAGE 2   

   53   1        
   54   1          if((BLDC_MIN_BATTERY > battery_voltage))
   55   1          {
   56   2              low_power_num++;
   57   2              if((2000 ) < (low_power_num / 20))    // 2s都超过电压保护值，则进行停机保护
   58   2              {
   59   3                 return 1;   
   60   3              }
   61   2          }
   62   1          else
   63   1          {
   64   2              low_power_num = 0;
   65   2          }
   66   1      
   67   1        return 0;
   68   1      }
   69          
   70          //-------------------------------------------------------------------------------------------------------
             -------------
   71          //  @brief      电池电压检测初始化
   72          //  @param      void                        
   73          //  @return     void          
   74          //  @since      v1.0
   75          //  Sample usage:
   76          //-------------------------------------------------------------------------------------------------------
             -------------
   77          void battery_init(void)
   78          {
   79   1        
   80   1        gpio_init(IO_P15, GPI, 0, GPI_IMPEDANCE);
   81   1        
   82   1        ADC_CONTR = 0x80;           // ADC使能
   83   1        ADCTIM = 0x3f;              // 设置通道选择时间、保持时间、采样时间
   84   1        ADCCFG = 0x0F;              // 左对齐，ADC转换时间最大
   85   1      
   86   1        DMA_ADC_STA = 0x00;
   87   1        DMA_ADC_CFG = 0x0F;   
   88   1        DMA_ADC_RXAH = (uint8)(DMA_ADDR >> 8);  //ADC转换数据存储地址
   89   1        DMA_ADC_RXAL = (uint8)DMA_ADDR;
   90   1        DMA_ADC_CFG2 = 0x00;          // 每个通道ADC转换次数:1
   91   1        DMA_ADC_CHSW0 = 1<<5;           // 
   92   1        DMA_ADC_CHSW1 = 0;              // ADC通道使能寄存器
   93   1        DMA_ADC_CR = 0xc0;            // 使能ADC_DMA,ADC开始转换。
   94   1        
   95   1          // 初始化的时候先采集一次电压
   96   1          battery_voltage_get();
   97   1      }
