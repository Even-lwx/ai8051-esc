  140   1          gpio_init(IO_P21, GPI, 0, GPI_IMPEDANCE);
  141   1          gpio_init(IO_P23, GPI, 0, GPI_IMPEDANCE);
  142   1          
  143   1          PWMB_PS = 0x0A;   // 通道引脚切换
  144   1          PWMB_CCMR1 = 0x01;  // CC5为输入模式,且映射到TI5FP5上
  145   1        PWMB_CCMR2 = 0x02;  // CC6为输入模式,且映射到TI5FP6上
  146   1          
  147   1        // CC5E 开启输入捕获
  148   1        // CC5P 捕获发生在TI5F的上升沿
  149   1        // CC6E 开启输入捕获
  150   1        // CC6P 捕获发生在TI5F的下降沿
  151   1          PWMB_CCER1 = 0x31;
  152   1          
  153   1          PWMB_PSCRH = 0;   // 分频值
  154   1        PWMB_PSCRL = system_clock / 1000000 - 1;    // 分频值
  155   1          PWMB_ARRH = 0xff;
  156   1          PWMB_ARRL = 0xff;
  157   1          PWMB_SMCR = 0x54; // TS=TI1FP1,SMS=TI1上升沿复位模式
  158   1        PWMB_CR1 = 0x04;  // URS=1，仅计数器溢出产生更新请求
  159   1          PWMB_EGR = 0x01;  // 装载预分频和自动重装值
  160   1        PWMB_IER = PWMB_SR1_CC5IF | PWMB_SR1_CC6IF;
  161   1        PWMB_CR1 |= 0x01; // 启动PWMB，向上计数
  162   1      
  163   1          pwmin.period = 0;
  164   1          pwmin.high_value = 0;
  165   1          pwmin.high_time = 0;
  166   1          pwmin.throttle = 0;
  167   1          pwmin_period_valid = 0;
  168   1          pwm_input_timeout_count = 0;
  169   1      
  170   1      #if (BLDC_USR_DUTY > 0)
