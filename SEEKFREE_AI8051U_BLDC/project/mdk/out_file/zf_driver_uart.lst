  374   3                  if((UART2_RX_P12 == rx_pin) && (UART2_TX_P13 == tx_pin))
  375   3                  {
  376   4                      P_SW2 |= 0x00;
  377   4                  }
  378   3                  else if((UART2_RX_P42 == rx_pin) && (UART2_TX_P43 == tx_pin))
  379   3                  {
  380   4                      P_SW2 |= 0x01;
  381   4                  }
  382   3                  
  383   3                  //            IE2 |= 0x01 << 0; //允许串行口2中断
  384   3                  
  385   3                  break;
  386   3              }
  387   2              
  388   2              case UART_3:
  389   2              {
  390   3                  //            if(TIM_2 == tim_n)
  391   3                  {
  392   4                      S3CON |= 0x10;
  393   4                      T2L = brt;
  394   4                      T2H = brt >> 8;
  395   4                      AUXR |= 0x14;
  396   4                  }
  397   3                  //            else if(TIM_3 == tim_n)
  398   3                  //            {
  399   3                  //                S3CON |= 0x50;
  400   3                  //                T3L = brt;
  401   3                  //                T3H = brt >> 8;
  402   3                  //                T4T3M |= 0x0a;
  403   3                  //            }
  404   3                  
  405   3                  P_SW2 &= ~(0x01 << 1);
  406   3                  
  407   3                  if((UART3_RX_P00 == rx_pin) && (UART3_TX_P01 == tx_pin))
  408   3                  {
  409   4                      P_SW2 |= 0x00;
  410   4                  }
  411   3                  else if((UART3_RX_P50 == rx_pin) && (UART3_TX_P51 == tx_pin))
  412   3                  {
  413   4                      P_SW2 |= 0x02;
  414   4                  }
  415   3                  
  416   3                  //            IE2 |= 0x01 << 3; //允许串行口3中断
  417   3                  
  418   3                  break;
  419   3              }
  420   2              
  421   2              case UART_4:
  422   2              {
  423   3                  //            if(TIM_2 == tim_n)
  424   3                  {
  425   4                      S4CON |= 0x10;
  426   4                      T2L = brt;
  427   4                      T2H = brt >> 8;
  428   4                      AUXR |= 0x14;
  429   4                  }
C251 COMPILER V5.60.0,  zf_driver_uart                                                     08/08/26  11:10:18  PAGE 8   

  430   3                  //            else if(TIM_4 == tim_n)
  431   3                  //            {
  432   3                  //                S4CON |= 0x50;
  433   3                  //                T4L = brt;
  434   3                  //                T4H = brt >> 8;
  435   3                  //                T4T3M |= 0xa0;
  436   3                  //            }
  437   3                  
  438   3                  P_SW2 &= ~(0x01 << 2);
  439   3                  
  440   3                  if((UART4_RX_P02 == rx_pin) && (UART4_TX_P03 == tx_pin))
  441   3                  {
  442   4                      P_SW2 |= 0x00;
  443   4                  }
  444   3                  else if((UART4_RX_P52 == rx_pin) && (UART4_TX_P53 == tx_pin))
  445   3                  {
  446   4      //                P5M0 = 0x00;
  447   4      //                P5M1 = 0x01 << 2; //P5.2 需要设置为高阻
  448   4                      P_SW2 |= 0x04;
  449   4                  }
  450   3                  
  451   3                  //            IE2 |= 0x01 << 4; //允许串行口4中断
  452   3                  
  453   3                  break;
  454   3              }
  455   2              
  456   2          }
