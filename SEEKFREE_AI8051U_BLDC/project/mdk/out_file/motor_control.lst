   63          uint16 tim4_reconfig(void)
   64          {
   65   1          uint16 temp;
   66   1          // 获取换相时间
   67   1          T4T3M &= ~0x80; // 停止定时器
   68   1          temp = (T4H << 8) | T4L;
   69   1          T4L = 0;
   70   1          T4H = 0;
   71   1          T4T3M |= 0x80;  // 开启定时器
   72   1          return temp;
   73   1      }
