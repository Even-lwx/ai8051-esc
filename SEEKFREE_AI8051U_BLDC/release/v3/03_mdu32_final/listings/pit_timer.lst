   54          void led_control(void)
   55          {
   56   1          #define TICK_TO_MS(ms)  (ms * 20)
   57   1          // 50us进一次该函数
   58   1          // LED状态显示
   59   1          if(BYTE_LOW_VOLTAGE == motor.run_flag)
   60   1          {
   61   2              // 电池电压过低，ERROR LED慢闪
   62   2              ERR_LED = 0;
   63   2              RUN_LED = 1;
   64   2          }
   65   1          else if(MOTOR_RESTART == motor.run_flag)
   66   1          {
   67   2              // 由于堵转造成的停止
   68   2              if(0 == (pit_count%TICK_TO_MS(50)))
   69   2              {
   70   3                  ERR_LED = !ERR_LED;
   71   3                  RUN_LED = 1;
   72   3              }
   73   2          }
   74   1          else if(MOTOR_IDLE == motor.run_flag)
   75   1          {
   76   2              // 空闲状态
   77   2              if(0 == (pit_count%TICK_TO_MS(200)))
   78   2              {
   79   3                  RUN_LED = !RUN_LED;
   80   3                  ERR_LED = 1;
   81   3              }
   82   2          }
   83   1          else if(MOTOR_START == motor.run_flag || MOTOR_OPEN_LOOP == motor.run_flag || MOTOR_CLOSE_LOOP == mot
             -or.run_flag)
   84   1          {
   85   2              // 电机转动状态
   86   2              ERR_LED = 1;
   87   2              RUN_LED = 0;
   88   2          }
   89   1        
   90   1      }
