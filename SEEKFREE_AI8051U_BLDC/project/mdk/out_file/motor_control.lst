   75          uint16 tim4_reconfig(void)
   76          {
   77   1          uint16 temp;
   78   1          // 获取换相时间
   79   1          T4T3M &= ~0x80; // 停止定时器
   80   1          temp = (T4H << 8) | T4L;
   81   1          T4L = 0;
   82   1          T4H = 0;
   83   1          T4T3M |= 0x80;  // 开启定时器
   84   1          return temp;
   85   1      }
