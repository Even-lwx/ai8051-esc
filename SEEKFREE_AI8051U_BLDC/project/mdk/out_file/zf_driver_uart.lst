  107          //-------------------------------------------------------------------------------------------------------
             -------------
  108          void uart_write_buffer(uart_index_enum uart_n, const uint8 *buff, uint16 len)
  109          {
  110   1          #define BUFF_LEN 64
  111   1        
  112   1        // 因UART_DMA只能操作xdata区域的数据，所以，这里新建一个数组，搬移。
  113   1        uint8 xdata tmp_buff[BUFF_LEN] = {0};
  114   1          uint16 tmp_len;
  115   1        while(len)
  116   1        {
C251 COMPILER V5.60.0,  zf_driver_uart                                                     08/08/26  11:10:18  PAGE 3   

  117   2              tmp_len = (len > BUFF_LEN) ? BUFF_LEN : len;        // 计算长度
  118   2              memcpy(tmp_buff, buff, tmp_len);                    // 拷贝
  119   2              len -= tmp_len;                                     // 去掉已经发送的长度
  120   2              buff += tmp_len;                                    // 指针指向后面
  121   2              
  122   2              //  DMA_URXT_CFG(uart_n)  = 0x00;                 // DMA优先级低
  123   2              DMA_URXT_STA(uart_n) = 0;                   // 清空标志位
  124   2      
  125   2              DMA_URXT_AMT(uart_n)  = (tmp_len - 1) & 0xff;   // 设置传输总字节数(低8位)：n+1
  126   2              DMA_URXT_AMTH(uart_n) = (tmp_len - 1) >> 8;       // 设置传输总字节数(高8位)：n+1
  127   2              DMA_URXT_TXAH(uart_n) = (uint8)((uint16)tmp_buff >> 8);
  128   2              DMA_URXT_TXAL(uart_n) = (uint8)((uint16)tmp_buff);
  129   2              DMA_URXT_CR(uart_n) = 0xC0;                   // 使能DMA TX功能
  130   2      
  131   2              while(!(DMA_URXT_STA(uart_n) & 0x01));              // 等待发送完成
  132   2      
  133   2              DMA_URXT_CR(uart_n) = 0x00;                   // 关闭DMA TX
  134   2        }
  135   1      }
