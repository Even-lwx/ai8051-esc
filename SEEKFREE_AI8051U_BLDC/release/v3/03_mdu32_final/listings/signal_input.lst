   53   1          uint8 sr1 = PWMB_SR1;
   54   1          uint8 sr2 = PWMB_SR2;
   55   1          uint8 capture_high;
   56   1          uint8 frame_overcapture;
   57   1          uint16 temp;
   58   1          frame_overcapture = sr2 & (PWMB_SR2_CC5OF | PWMB_SR2_CC6OF);
   59   1      
   60   1          if(sr1 & PWMB_SR1_CC5IF)
   61   1          {
   62   2              // 必须先读取高字节，再单独读取低字节；读取低字节会清除 CC5 标志。
   63   2              capture_high = PWMB_CCR5H;
   64   2              pwmin.period = ((uint16)capture_high << 8);
